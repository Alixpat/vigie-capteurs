[Unit]
Description=Vigie - Capteur TTN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WORKING_DIR__
ExecStart=__WORKING_DIR__/venv/bin/python3 capteur_ttn.py /etc/vigie/capteur-ttn/config.json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
